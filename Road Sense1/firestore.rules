rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== POTHOLES COLLECTION ====================
    // This is the main collection where pothole reports are stored
    
    match /potholes/{potholeId} {
      
      // READ: Anyone can read (public dashboard needs this)
      allow read: if true;
      
      // CREATE: Only authenticated users can create reports
      // Data validation ensures proper structure
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['lat', 'lon', 'severity', 'timestamp', 'userId'])
                    && request.resource.data.lat is number
                    && request.resource.data.lon is number
                    && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                    && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
                    && request.resource.data.severity in [1, 2, 3]
                    && request.resource.data.userId == request.auth.uid;
      
      // UPDATE/DELETE: Not allowed (immutable reports for data integrity)
      // If you need to allow users to delete their own reports, change to:
      // allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ==================== USERS COLLECTION (Optional - for future features) ====================
    // Uncomment if you want user profiles
    
    // match /users/{userId} {
    //   allow read: if request.auth != null && request.auth.uid == userId;
    //   allow write: if request.auth != null && request.auth.uid == userId;
    // }
    
    // ==================== BLOCK ALL OTHER COLLECTIONS ====================
    // Security: Deny access to any collection not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
